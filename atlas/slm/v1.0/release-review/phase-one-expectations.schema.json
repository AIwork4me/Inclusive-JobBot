{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_manifest_sha256", "reviewer_id", "review_scope", "expectations", "semantic_duplicate_findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_id": {"type": "string", "pattern": "^reviewer-[a-z0-9-]+$"},
    "review_scope": {
      "enum": ["READ_ONLY_MECHANICAL", "STATEFUL", "AFFIRMATIVE_WRITE", "STRICT_END_TO_END", "CONTENT_AND_PARTITION"]
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "branches"],
        "properties": {
          "case_id": {"$ref": "#/$defs/text"},
          "branches": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition", "required_dependencies", "acceptable_actions", "forbidden_actions", "terminal_facts", "authority_requirements"],
              "properties": {
                "condition": {"$ref": "#/$defs/text"},
                "required_dependencies": {"$ref": "#/$defs/notes"},
                "acceptable_actions": {"$ref": "#/$defs/notes"},
                "forbidden_actions": {"$ref": "#/$defs/notes"},
                "terminal_facts": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/text"}},
                "authority_requirements": {"$ref": "#/$defs/notes"}
              }
            }
          }
        }
      }
    },
    "semantic_duplicate_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_ids", "reason"],
        "properties": {
          "case_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
          "reason": {"$ref": "#/$defs/text"}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "notes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
