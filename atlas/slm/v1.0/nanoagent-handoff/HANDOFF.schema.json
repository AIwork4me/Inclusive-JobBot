            "properties": {
              "permission_expansion": {
                "const": "BLOCKED"
              },
              "qualified_autonomy": {
                "const": "BLOCKED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "OPEN_RISKS"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "D25",
              "production",
              "AG11",
              "planning_and_complexity",
              "npu_physical",
              "intervention_acceptance"
