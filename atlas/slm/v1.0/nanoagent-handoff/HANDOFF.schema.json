            "properties": {
              "arms": {
                "type": "object",
                "required": [
                  "R0",
                  "R1",
                  "R2",
                  "R3",
                  "R4",
                  "R5",
                  "R6",
                  "R7"
                ],
                "properties": {}
              },
              "pair_key": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hold_constant": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "capture": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evaluation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "const": "NOT_RUN"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RESOURCE_BASELINES"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "A",
              "B",
              "D"
            ],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "AUTONOMY_PERMISSION_MATRIX"
