              "properties": {
                "failure_id": {
                  "type": "string",
                  "pattern": "^[ABD]-[a-z]+$"
                },
                "model": {
                  "enum": [
                    "A",
                    "B",
                    "D"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "metric": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "frequency_status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "BLOCKED",
                    "NOT_RUN"
                  ]
                },
                "failure_frequency": {
                  "type": "object"
                },
                "source_evidence": {
                  "type": "object",
                  "required": [
                    "matrix",
                    "manifest"
                  ],
                  "properties": {
                    "matrix": {
                      "type": "string",
                      "minLength": 1
                    },
                    "manifest": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "runtime_identity_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed_root_cause": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unverified_hypothesis": {
                  "type": "string",
                  "minLength": 1
                },
                "intervention_status": {
                  "const": "HYPOTHESIS"
                },
                "proposed_component": {
                  "type": "string",
                  "minLength": 1
                },
                "required_invariant": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_benefit": {
                  "type": "string",
                  "minLength": 1
                },
                "validation_experiment": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_benefit": {
                  "const": "NOT_RUN"
                },
                "resource_overhead": {
                  "const": "NOT_RUN"
                },
                "remaining_risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "qualification_scope": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
