      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "A",
              "B",
              "D"
            ],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "MODEL_FAILURE_SIGNATURES"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "failure_id",
                "model",
                "description",
                "metric",
                "frequency_status",
                "failure_frequency",
                "source_evidence"
              ],
              "properties": {
                "failure_id": {
                  "type": "string",
                  "pattern": "^[ABD]-[a-z]+$"
                },
                "model": {
                  "enum": [
                    "A",
                    "B",
                    "D"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "metric": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "frequency_status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "BLOCKED",
                    "NOT_RUN"
                  ]
                },
                "failure_frequency": {
                  "type": "object"
                },
                "source_evidence": {
                  "type": "object",
                  "required": [
                    "matrix",
                    "manifest"
                  ],
                  "properties": {
                    "matrix": {
                      "type": "string",
                      "minLength": 1
                    },
                    "manifest": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CAPABILITY_DEFICITS"
          }
        }
