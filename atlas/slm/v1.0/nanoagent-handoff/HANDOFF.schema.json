                "metric": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "qualification_scope": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "COMPENSATION_COMPONENTS"
