{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "scope",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": [
        "HANDOFF_MANIFEST",
        "EVIDENCE_MANIFEST",
        "MODEL_CAPABILITIES",
        "SDK_CAPABILITY_DELTA",
        "MODEL_FAILURE_SIGNATURES",
        "CAPABILITY_DEFICITS",
        "COMPENSATION_COMPONENTS",
        "CAPABILITY_COMPONENT_MAPPING",
        "MATCHED_BENCHMARK_CONTRACT",
        "RESOURCE_BASELINES",
        "AUTONOMY_PERMISSION_MATRIX",
        "OPEN_RISKS"
      ]
    },
    "scope": {
      "const": "TC-V3/1.0 synthetic Radeon tool-calling measurement"
    },
    "data": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "HANDOFF_MANIFEST"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "source_git_sha",
              "core_trial_attribution",
              "files"
            ],
            "properties": {
              "source_git_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "core_trial_attribution": {
                "const": 0
              },
              "files": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "EVIDENCE_MANIFEST"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "source_git_sha",
              "coverage",
              "files",
              "derived_priority_rows_sha256",
              "raw_portable_sessions"
            ],
            "properties": {
              "source_git_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "coverage": {
                "type": "object",
                "required": [
                  "planned",
                  "executed",
                  "sealed"
                ],
                "properties": {
                  "planned": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "executed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sealed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "files": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "derived_priority_rows_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "raw_portable_sessions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "path",
                    "manifest_sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "manifest_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "MODEL_CAPABILITIES"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "A",
              "B",
              "D"
            ],
            "properties": {},
            "additionalProperties": {
              "type": "object",
              "required": [
                "configurations",
                "metrics",
                "strict_d25"
              ],
              "properties": {
                "configurations": {
                  "type": "array",
                  "minItems": 1
                },
                "metrics": {
                  "type": "array",
                  "minItems": 1
                },
                "strict_d25": {
                  "const": "BLOCKED"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SDK_CAPABILITY_DELTA"
          }
        }
