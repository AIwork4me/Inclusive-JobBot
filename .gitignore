# Model weights are never committed; only the manifest that describes them.
models/*
!models/model_manifest.json
!models/README.md
*.gguf
*.safetensors

# llama.cpp engine binaries are downloaded by scripts, never committed.
runtime/llama-cpp/*
!runtime/llama-cpp/README.md

# Frontend and browser automation
frontend/node_modules/
frontend/dist/
playwright-report/
test-results/

# Secrets and local configuration
.env
.env.*
*.key
secrets/

# OS / editor
Thumbs.db
.DS_Store
