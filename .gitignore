# Python
.venv/
.venvs/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Local tools, downloaded archives and scratch space
.tools/
.scratch/
.runtime/
*.part
.writer.lock

# Model weights are never committed; only the manifests that describe them.
# A directory ignored by "models/*" must be re-included before a file inside it
# can be, which is why the IJ-SDK passport needed its own two lines.
models/*
!models/model_manifest.json
!models/README.md
!models/ij_sdk/
models/ij_sdk/*
!models/ij_sdk/model_manifest.json
*.gguf
*.safetensors

# llama.cpp engine binaries are downloaded by scripts, never committed.
runtime/llama-cpp/*
!runtime/llama-cpp/README.md

# Frontend and browser automation
frontend/node_modules/
frontend/dist/
playwright-report/
test-results/

# Secrets and local configuration
.env
.env.*
*.key
secrets/

# OS / editor
Thumbs.db
.DS_Store

# N03 protected confirmation assets (answer-bearing; local only, hash manifest is committed)
evaluation/ij_nano/n03/protected/
