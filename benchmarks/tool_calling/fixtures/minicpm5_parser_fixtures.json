{
  "schema_version": 1,
  "version": "1.0.1",
  "purpose": "Fixed MiniCPM5 native outputs with expectations defined before running. Valid fixtures must parse to exactly the expected calls. Invalid fixtures must never produce a fabricated tool name, parameter or value.",
  "expect_modes": {
    "exact": "the parsed tool_calls must equal expected.calls: same count, names, arguments and types",
    "no_fabrication": "either no tool call at all, or every tool call must appear in expected.allowed_calls; content must not gain a call"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_purchase_order",
        "description": "按订单号查询采购订单。",
        "parameters": {
          "type": "object",
          "properties": {
            "order_id": {
              "type": "string",
              "description": "采购订单号"
            }
          },
          "required": [
            "order_id"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "create_ticket",
        "description": "创建售后工单。",
        "parameters": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "低",
                "中",
                "高"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "subject",
            "priority",
            "tags"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "update_product_record",
        "description": "更新商品资料字段。",
        "parameters": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "个",
                    "箱",
                    "包"
                  ]
                },
                "price": {
                  "type": "number"
                }
              }
            }
          },
          "required": [
            "sku",
            "fields"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_knowledge_base",
        "description": "检索知识库。",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "top_k": {
              "type": "integer"
            },
            "include_archived": {
              "type": "boolean"
            }
          },
          "required": [
            "query",
            "top_k"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calculate_total",
        "description": "计算明细金额合计。",
        "parameters": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sku": {
                    "type": "string"
                  },
                  "unit_price": {
                    "type": "number"
                  },
                  "quantity": {
                    "type": "integer"
                  }
                },
                "required": [
                  "sku",
                  "unit_price",
                  "quantity"
                ]
              }
            }
          },
          "required": [
            "items"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "schedule_follow_up",
        "description": "为客户安排回访。",
        "parameters": {
          "type": "object",
          "properties": {
            "customer_id": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "customer_id",
            "note"
          ]
        }
      }
    }
  ],
  "fixtures": [
    {
      "id": "fx-valid-single",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"get_purchase_order\"><param name=\"order_id\">PO-2026-0123</param></function>",
      "expected": {
        "calls": [
          {
            "name": "get_purchase_order",
            "arguments": {
              "order_id": "PO-2026-0123"
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-chinese-unicode",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"update_product_record\"><param name=\"sku\">SKU-4567</param><param name=\"fields\">{\"name\": \"A4 复印纸（加厚型）\", \"unit\": \"箱\"}</param></function>",
      "expected": {
        "calls": [
          {
            "name": "update_product_record",
            "arguments": {
              "sku": "SKU-4567",
              "fields": {
                "name": "A4 复印纸（加厚型）",
                "unit": "箱"
              }
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-multi",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"get_purchase_order\"><param name=\"order_id\">PO-2026-0001</param></function>\n<function name=\"get_purchase_order\"><param name=\"order_id\">PO-2026-0002</param></function>",
      "expected": {
        "calls": [
          {
            "name": "get_purchase_order",
            "arguments": {
              "order_id": "PO-2026-0001"
            }
          },
          {
            "name": "get_purchase_order",
            "arguments": {
              "order_id": "PO-2026-0002"
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-cdata",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"schedule_follow_up\"><param name=\"customer_id\">CU-345</param><param name=\"note\"><![CDATA[数量<最小起订量 & 需要确认\n客户要求加急]]></param></function>",
      "expected": {
        "calls": [
          {
            "name": "schedule_follow_up",
            "arguments": {
              "customer_id": "CU-345",
              "note": "数量<最小起订量 & 需要确认\n客户要求加急"
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-cdata-closing-tag-inside",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"schedule_follow_up\"><param name=\"customer_id\">CU-345</param><param name=\"note\"><![CDATA[原文 </param> 结束]]></param></function>",
      "expected": {
        "calls": [
          {
            "name": "schedule_follow_up",
            "arguments": {
              "customer_id": "CU-345",
              "note": "原文 </param> 结束"
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-nested-object",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"update_product_record\"><param name=\"sku\">SKU-7788</param><param name=\"fields\">{\"name\": \"签字笔\", \"unit\": \"箱\", \"price\": 19.99}</param></function>",
      "expected": {
        "calls": [
          {
            "name": "update_product_record",
            "arguments": {
              "sku": "SKU-7788",
              "fields": {
                "name": "签字笔",
                "unit": "箱",
                "price": 19.99
              }
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-array-of-objects",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"calculate_total\"><param name=\"items\">[{\"sku\": \"SKU-1\", \"unit_price\": 12.5, \"quantity\": 3}, {\"sku\": \"SKU-2\", \"unit_price\": 0.75, \"quantity\": 40}]</param></function>",
      "expected": {
        "calls": [
          {
            "name": "calculate_total",
            "arguments": {
              "items": [
                {
                  "sku": "SKU-1",
                  "unit_price": 12.5,
                  "quantity": 3
                },
                {
                  "sku": "SKU-2",
                  "unit_price": 0.75,
                  "quantity": 40
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-enum-array",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"create_ticket\"><param name=\"subject\">商品破损</param><param name=\"priority\">高</param><param name=\"tags\">[\"质量\", \"退货\"]</param></function>",
      "expected": {
        "calls": [
          {
            "name": "create_ticket",
            "arguments": {
              "subject": "商品破损",
              "priority": "高",
              "tags": [
                "质量",
                "退货"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-integer-boolean-optional",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"search_knowledge_base\"><param name=\"query\">报销流程</param><param name=\"top_k\">3</param><param name=\"include_archived\">false</param></function>",
      "expected": {
        "calls": [
          {
            "name": "search_knowledge_base",
            "arguments": {
              "query": "报销流程",
              "top_k": 3,
              "include_archived": false
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-optional-omitted",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"search_knowledge_base\"><param name=\"query\">发票</param><param name=\"top_k\">1</param></function>",
      "expected": {
        "calls": [
          {
            "name": "search_knowledge_base",
            "arguments": {
              "query": "发票",
              "top_k": 1
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-thinking-before-call",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<think>\n用户要查订单，需要调用工具。\n</think>\n\n<function name=\"get_purchase_order\"><param name=\"order_id\">PO-2026-0910</param></function>",
      "expected": {
        "calls": [
          {
            "name": "get_purchase_order",
            "arguments": {
              "order_id": "PO-2026-0910"
            }
          }
        ],
        "reasoning_contains": "调用工具"
      }
    },
    {
      "id": "fx-valid-text-before-call",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "我来为您查询订单。\n<function name=\"get_purchase_order\"><param name=\"order_id\">PO-2026-0777</param></function>",
      "expected": {
        "calls": [
          {
            "name": "get_purchase_order",
            "arguments": {
              "order_id": "PO-2026-0777"
            }
          }
        ],
        "content_contains": "查询"
      }
    },
    {
      "id": "fx-valid-empty-string",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"schedule_follow_up\"><param name=\"customer_id\">CU-111</param><param name=\"note\"></param></function>",
      "expected": {
        "calls": [
          {
            "name": "schedule_follow_up",
            "arguments": {
              "customer_id": "CU-111",
              "note": ""
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-whitespace-between-tags",
      "kind": "valid",
      "expect_mode": "exact",
      "native_output": "<function name=\"get_purchase_order\">\n  <param name=\"order_id\">\n    PO-2026-0333\n  </param>\n</function>\n\n<function name=\"get_purchase_order\"><param name=\"order_id\">PO-2026-0334</param></function>",
      "expected": {
        "calls": [
          {
            "name": "get_purchase_order",
            "arguments": {
              "order_id": "PO-2026-0333"
            }
          },
          {
            "name": "get_purchase_order",
            "arguments": {
              "order_id": "PO-2026-0334"
            }
          }
        ]
      }
    },
    {
      "id": "fx-valid-long-param",
