{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "goal": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "$ref": "#/$defs/condition"
          },
          "disposition": {
            "enum": [
              "completed",
              "understood",
              "clarify",
              "escalate"
            ]
          },
          "facts": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/term"
            }
          }
        },
        "required": [
          "when",
          "disposition"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [
    "version",
    "goal",
    "actions",
    "stops"
  ],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "from",
        "field"
      ],
      "additionalProperties": false
    },
    "term": {
      "oneOf": [
        {
          "type": [
            "boolean",
            "integer",
            "string",
            "null"
          ]
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "object",
          "properties": {
            "first": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "first"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "if": {
              "$ref": "#/$defs/condition"
            },
            "then": {
              "type": "string"
            },
            "else": {
              "type": "string"
            }
          },
          "required": [
            "if",
            "then",
            "else"
          ],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "lt",
                "le",
                "gt",
                "ge"
              ]
            },
            "left": {
              "$ref": "#/$defs/term"
            },
            "right": {
              "$ref": "#/$defs/term"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "exists"
            },
            "ref": {
              "$ref": "#/$defs/ref"
            }
          },
          "required": [
            "op",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "op",
            "arg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1,
              "maxItems": 16
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "observes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "tool",
        "depends_on",
        "arguments",
        "when"
      ],
      "additionalProperties": false
    }
  }
}
