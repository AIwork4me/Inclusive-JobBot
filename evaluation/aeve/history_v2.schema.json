{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage-specific historical AEVE input, revision 2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projection_version": {
      "const": 2
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_family": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^D(0[1-9]|1[0-9]|2[0-5])$"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content": {}
        }
      }
    },
    "dimension_event_ids": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^D(0[1-9]|1[0-9]|2[0-5])$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "record_class": {
      "enum": [
        "software_witness",
        "no_llm_control",
        "offline_replay",
        "mutation",
        "fixture",
        "derived_evidence"
      ]
    }
  },
  "required": [
    "projection_version",
    "source_sha256",
    "trial_id",
    "source_family",
    "dimensions",
    "events",
    "dimension_event_ids"
  ]
}
