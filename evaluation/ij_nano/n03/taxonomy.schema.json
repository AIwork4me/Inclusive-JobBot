{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "IJ-NANO N03 cognitive primitive taxonomy contract (IJ-NANO-1.3S §6.1)",
 "type": "object",
 "required": ["schema", "mission_order", "shared_eae_core", "protocol_vocabulary", "primitives"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "ij_nano.n03.taxonomy.v1"},
  "mission_order": {"type": "string"},
  "shared_eae_core": {"type": "array", "items": {"type": "string"}},
  "protocol_vocabulary": {
   "type": "object",
   "additionalProperties": {"type": "string"}
  },
  "primitives": {
   "type": "object",
   "minProperties": 32,
   "maxProperties": 32,
   "propertyNames": {"pattern": "^C(0[1-9]|[12][0-9]|3[0-2])$"},
   "additionalProperties": {"$ref": "#/definitions/primitive"}
  }
 },
 "definitions": {
  "primitive": {
   "type": "object",
   "required": [
    "primitive_id", "capability", "batch",
    "cognitive_definition", "required_observable_behavior",
    "capability_isolation", "public_task_information", "output_contract",
    "applicable_protocols", "independent_ground_truth",
    "correct_witnesses", "incorrect_witnesses", "valid_alternatives",
    "boundary_cases", "difficulty_dimensions", "failure_taxonomy",
    "additional_eae_dependencies"
   ],
   "additionalProperties": false,
   "properties": {
    "primitive_id": {"pattern": "^C(0[1-9]|[12][0-9]|3[0-2])$"},
    "capability": {"type": "string", "minLength": 3},
    "batch": {"enum": ["A", "B", "C", "D"]},
    "cognitive_definition": {"type": "string", "minLength": 20},
    "required_observable_behavior": {"type": "string", "minLength": 20},
    "capability_isolation": {
     "type": "object",
     "required": ["label", "note"],
     "additionalProperties": false,
     "properties": {
      "label": {"enum": ["isolated_capability", "diagnostic_isolation",
                          "agentic_component"]},
      "note": {"type": "string", "minLength": 20}
     }
    },
    "public_task_information": {"type": "string", "minLength": 20},
    "output_contract": {
     "type": "object",
     "required": ["representation", "constraints"],
     "additionalProperties": false,
     "properties": {
      "representation": {"type": "string", "minLength": 5},
      "constraints": {"type": "array", "minItems": 1,
                       "items": {"type": "string"}}
     }
    },
    "applicable_protocols": {"type": "array", "minItems": 1,
      "items": {"type": "string"}},
    "independent_ground_truth": {"type": "string", "minLength": 20},
    "correct_witnesses": {"type": "array", "minItems": 2,
      "items": {"type": "string"}},
    "incorrect_witnesses": {"type": "array", "minItems": 2,
      "items": {"type": "string"}},
    "valid_alternatives": {"type": "array", "minItems": 1,
      "items": {"type": "string"}},
    "boundary_cases": {"type": "array", "minItems": 2,
      "items": {"type": "string"}},
    "difficulty_dimensions": {"type": "array", "minItems": 2,
      "items": {"type": "string"}},
    "failure_taxonomy": {"type": "array", "minItems": 3,
      "items": {"type": "string"}},
    "additional_eae_dependencies": {"type": "array",
      "items": {"type": "string"}}
   }
  }
 }
}
