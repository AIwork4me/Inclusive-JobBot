delivery.\n", "ttft_ms": 192, "wall_ms": 49576, "finish_reason": "length", "truncated": true, "usage": {"completion_tokens": 800, "prompt_tokens": 37, "total_tokens": 837, "prompt_tokens_details": {"cached_tokens": 4}}, "prompt_n": 33, "prompt_ms": 161.015, "predicted_n": 800, "predicted_ms": 49383.241, "error": null}
